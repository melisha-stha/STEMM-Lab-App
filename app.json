{
  "expo": {
    "name": "STEMM-Lab-App",
    "slug": "STEMM-Lab-App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/welcomelogo.png",
    "scheme": "stemmlabapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stemmlab.stemmlabapp",
      "config": {
        "googleMapsApiKey": "AIzaSyAU9gVtBwotB3ivD76K9reMk8_F4IpSXSQ"
      }
    },
    "android": {
      "package": "com.stemmlab.stemmlabapp",
      "versionCode": 1,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAU9gVtBwotB3ivD76K9reMk8_F4IpSXSQ"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#C4B5E8",
        "foregroundImage": "./assets/images/welcomelogo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "assetBundlePatterns": [
      "assets/**"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share parachute drop results.",
          "cameraPermission": "The app accesses your camera to record your parachute drop trials.",
          "microphonePermission": "The app accesses your microphone to record audio during drops."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1472940621207668~2736870785",
          "iosAppId": "ca-app-pub-1472940621207668~5718257345"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0e19d0a6-350f-4191-a467-457f82169088"
      }
    }
  }
}
